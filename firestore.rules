rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isValidHandle(h) {
      return h is string && h.size() >= 3 && h.size() <= 20 && h.matches('^[a-z0-9_]+$');
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.elo == 500
        && request.resource.data.peak_elo == 500;

      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && math.abs(request.resource.data.elo - resource.data.elo) <= 250
        && request.resource.data.peak_elo >= resource.data.peak_elo;

      allow delete: if false;
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /handles/{handleName} {
      allow read: if true;
      allow create: if signedIn()
        && isValidHandle(handleName)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle == handleName;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }
  }
}
